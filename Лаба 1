#include <stdio.h>
#include <math.h>

int main() {
    double a = 1.0, b = -3.0, c = 2.0;
    double discriminant, x1, x2;

    discriminant = pow(b, 2) - 4 * a * c;

    if (discriminant >= 0) {
        x1 = (-b + sqrt(discriminant)) / (2 * a);
        x2 = (-b - sqrt(discriminant)) / (2 * a);
        printf("x1 = %f\n", x1);
        printf("x2 = %f\n", x2);
    } else {
        printf("Нет результата");
    }

    return 0;
}

