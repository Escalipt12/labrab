#include <stdio.h>
#include <string.h>

int main() {
    char str[81]; // Массив для строки (до 80 символов + '\0')
    

    printf("Введите строку (до 80 символов):\n");
    fgets(str, sizeof(str), stdin);

    if (str[strlen(str) - 1] == '\n') {
        str[strlen(str) - 1] = '\0';
    }
    

    for (int i = 0; str[i] != '\0'; i++) {
        if (str[i] == 'a') {
            str[i] = 'A';
        } else if (str[i] == 'b') {
            str[i] = 'B';
        }
    }
    
    printf("Полученная строка:\n%s\n", str);
    
    return 0;
}
