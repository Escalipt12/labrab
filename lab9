#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define MAX_INPUT 1000

double calculateExpression(char *expr) {
    // Удаляем пробелы из выражения
    char *src = expr, *dst = expr;
    while (*src) {
        if (!isspace((unsigned char)*src)) {
            *dst = *src;
            dst++;
        }
        src++;
    }
    *dst = '\0';

    double result = 0;
    char operator = '+';
    char *ptr = expr;

    // Обработка первого числа (возможно с унарным минусом)
    if (*ptr == '-') {
        operator = '-';
        ptr++;
    }
    
    result = strtod(ptr, &ptr);
    if (operator == '-') {
        result = -result;
    }

    // Обработка остальных чисел
    while (*ptr != '\0') {
        operator = *ptr;
        ptr++;
        
        double num = strtod(ptr, &ptr);
        if (operator == '+') {
            result += num;
        } else if (operator == '-') {
            result -= num;
        }
    }

    return result;
}

int main() {
    char expr[MAX_INPUT];
    
    printf("Enter expression (e.g. -123.5 + 4 - 456+56): ");
    if (fgets(expr, MAX_INPUT, stdin)) {
        expr[strcspn(expr, "\n")] = 0;
        
        double result = calculateExpression(expr);
        printf("Result: %.2f\n", result);
    }
    
    return 0;
} 
