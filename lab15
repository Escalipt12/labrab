#include <stdio.h>


void print_forward(int n) {
    if (n < 10) {
        printf("%d ", n);
        return;
    }
    print_forward(n / 10);
    printf("%d ", n % 10);
}


void print_backward(int n) {
    printf("%d ", n % 10);
    if (n >= 10) {
        print_backward(n / 10);
    }
}

int main() {
    int n;
    printf("Enter number: ");
    scanf("%d", &n);
    
    printf("Forward: ");
    print_forward(n);
    
    printf("\nBackward: ");
    print_backward(n);
    
    return 0;
} 
